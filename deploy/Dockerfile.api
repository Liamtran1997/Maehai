# syntax=docker/dockerfile:1
# Django API, shared by the api, worker and scheduler services (same image, different command).

# ---- build stage: has a C compiler (libscrc, used by PromptPay, has no prebuilt wheel) ----
FROM python:3.13-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /usr/local/bin/uv
WORKDIR /app
# Dependencies first so this layer is cached until the lockfile changes.
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

# ---- runtime stage: no compiler ----
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
COPY apps/api/ ./

# Collect Django admin static files (served by WhiteNoise). The key is a build-time placeholder, never used at runtime.
RUN DJANGO_DEBUG=0 DJANGO_SECRET_KEY=build-time-placeholder-not-used-at-runtime-0000 python manage.py collectstatic --noinput

RUN useradd --system --uid 10001 --home /app app && mkdir -p /data/media && chown -R app /data /app/staticfiles
USER app
ENV MEDIA_ROOT=/data/media DJANGO_DEBUG=0
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/api/health', timeout=4)" || exit 1

CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "60", \
     "--access-logfile", "-", "--forwarded-allow-ips", "*"]
