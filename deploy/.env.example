# Copy to deploy/.env and fill in. Never commit deploy/.env.

# --- Where the shop lives ---------------------------------------------------
# SITE_ADDRESS: the domain Caddy serves, e.g. maehai.example.com (HTTPS certificates are automatic once DNS points here).
#   For a local trial without HTTPS use http://localhost and set HTTP_PORT=8080.
SITE_ADDRESS=maehai.example.com
PUBLIC_HOST=maehai.example.com
PUBLIC_ORIGIN=https://maehai.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets (generate each: openssl rand -hex 32) --------------------------
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=          # letters and digits only (it is placed inside a URL)
POSTGRES_USER=maehai
POSTGRES_DB=maehai

# --- Payments (Thailand) ----------------------------------------------------
PROMPTPAY_ID=               # shop's PromptPay phone number or tax ID. Without it nobody can pay.
VAT_ENABLED=0               # 1 if the shop is VAT-registered
VAT_RATE=7
NON_WORKING_DATES=          # comma-separated YYYY-MM-DD, Thai public holidays the shop does not ship

# --- LINE Official Account --------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_ID=@maehai
LINE_STAFF_IDS=             # comma-separated user/group IDs

# --- Shop rules -------------------------------------------------------------
DEFAULT_FULFILLMENT_BRANCH=srinarong
LOW_STOCK_THRESHOLD=5
ORDER_UNPAID_EXPIRY_HOURS=24
