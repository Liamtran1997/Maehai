# Backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DATABASE_URL=postgres://maehai:maehai@localhost:5432/maehai
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Payments / Thailand
PROMPTPAY_ID=            # phone (0812345678) or tax id
SLIP_VERIFY_PROVIDER=    # slipok | easyslip
SLIP_VERIFY_API_KEY=
VAT_ENABLED=0
VAT_RATE=7

# LINE
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Shop server-side API URL (optional; falls back to NEXT_PUBLIC_API_URL)
API_URL=http://localhost:8000

# LINE Official Account (Messaging API). Get these in LINE Developers Console > your channel.
LINE_CHANNEL_ACCESS_TOKEN=     # long-lived channel access token
LINE_CHANNEL_SECRET=           # verifies webhook signatures
LINE_OA_ID=@maehai             # basic ID used for the "connect LINE" button
LINE_STAFF_IDS=                # comma-separated user/group IDs for staff alerts (send "/id" to the bot in a group to find it)
ADMIN_URL=http://localhost:5173
PUBLIC_SHOP_URL=http://localhost:3000

# Rate limiting (see RATE_LIMITS in apps/api/config/settings.py for the numbers)
RATE_LIMIT_ENABLED=1
TRUSTED_PROXY_COUNT=0          # set to the number of reverse proxies in front of the API (nginx = 1), or every visitor looks like the proxy
# REDIS_URL above is used for the counters when set; without it each worker counts on its own

# Inventory
DEFAULT_FULFILLMENT_BRANCH=srinarong   # delivery orders are filled from here first
LOW_STOCK_THRESHOLD=5
ORDER_UNPAID_EXPIRY_HOURS=24           # unpaid orders release their reserved stock after this long (run: manage.py expire_unpaid_orders hourly)

# Image storage (see deploy/.env.example for the full list)
STORAGE_BACKEND=local
IMAGE_MAX_MB=5
# PRIVATE_MEDIA_ROOT=./private_media   # where payment slips are kept on disk (local backend)
